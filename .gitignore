# Project runtime setup
.claude/
venv/
.venv/

# Runtime files: state/ holds per-pipeline state, the log, and the OAuth
# credentials/token -- all of it generated or secret, none of it committed.
*.log
state/
__pycache__/

# Environment files
.env
.env.*
!.env.example

# PII and sensitive data
# API tokens for the pipeline runner's http actions. .env.example carries the
# key names with empty values and is tracked.
# Real configs live in configs/*.yaml; the *.yaml.example templates are tracked.
configs/*.yaml
# Belt-and-braces: these live in state/ (already ignored), but a stray copy
# anywhere in the tree must never be committed either.
credentials.json
token.json
Statements/

# Extraction fixtures are real messages saved by --dump-body, so they carry
# account numbers and addresses. Commit one only after --redact.
tests/fixtures/

# Copy to .env and fill in. .env is gitignored; this file is not.
# The runner reads .env at startup, but the real environment wins on a
# conflict, so FINANCE_API_TOKEN=... python pipelines_runner.py overrides it.

# Bearer token for the API the electric_bill pipeline posts to.
FINANCE_API_TOKEN=

# API key for the service redfin_home_value posts to.
ASSETS_API_KEY=

# Password for encrypted PDF statements, if a pipeline reads one.
BANK_PDF_PASSWORD=
